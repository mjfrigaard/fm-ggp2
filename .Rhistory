#| echo: false
#| eval: true
# drop missing values
penguins <- tidyr::drop_na(penguins)
ggplot(data = penguins)
#| message: false
#| warning: false
#| echo: false
#| eval: true
#| dpi: 320
#| fig-asp: 0.618
ggplot(data = penguins,
mapping =
aes(x = flipper_length_mm,
y = bill_length_mm))
#| message: false
#| warning: false
#| echo: false
#| eval: true
#| dpi: 320
#| fig-asp: 0.618
ggplot(data = penguins,
mapping = aes(
x = flipper_length_mm,
y = bill_length_mm)) +
geom_point(aes(shape = sex))
#| message: false
#| warning: false
#| dpi: 320
#| fig-asp: 0.618
ggplot(data = penguins,
# layer 1
mapping = aes(
x = flipper_length_mm,
y = bill_length_mm)) +
geom_point(aes(shape = sex)) +
# layer 2
geom_smooth(
mapping = aes(
x = flipper_length_mm,
y = bill_length_mm,
color = species),
se = FALSE)
#| message: false
#| warning: false
#| dpi: 320
#| fig-asp: 0.618
ggplot(data = penguins,
# layer 1
mapping = aes(
x = flipper_length_mm,
y = bill_length_mm)) +
geom_point(aes(shape = sex),
size = 0.7,
alpha = 2/3) +
# layer 2
geom_smooth(
mapping = aes(
x = flipper_length_mm,
y = bill_length_mm,
color = species)) +
facet_wrap(. ~ island, nrow = 2) +
theme(legend.position = "top") +
labs(
x = 'Flipper length (mm)',
y = 'Bill length (mm)',
title = 'Penguins',
subtitle = 'Bills vs. Flippers'
)
#| message: false
